<Window x:Class="ConsoleApp1.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EcoDrive Manager" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F5F5F5">
        <StackPanel Margin="20">
            <TextBlock Text="EcoDrive-Manager" FontSize="24" FontWeight="Bold" Foreground="#2E5090" Margin="0,0,0,20"/>
            
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <Button Content="Optimize Distribution" Padding="10,5" Margin="5" Background="#4A90E2" Foreground="White"/>
                <Button Content="Sort Packages" Padding="10,5" Margin="5" Background="#4A90E2" Foreground="White"/>
                <Button Content="Calculate Costs" Padding="10,5" Margin="5" Background="#4A90E2" Foreground="White"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <Button Content="Find Best Route" Padding="10,5" Margin="5" Background="#4A90E2" Foreground="White"/>
                <Button Content="Generate Report" Padding="10,5" Margin="5" Background="#4A90E2" Foreground="White"/>
            </StackPanel>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Vehicles" FontWeight="Bold" Margin="0,0,0,10"/>
                    <ListBox Height="200" Background="White" BorderBrush="#D0D0D0" BorderThickness="1"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="Packages" FontWeight="Bold" Margin="0,0,0,10"/>
                    <ListBox Height="200" Background="White" BorderBrush="#D0D0D0" BorderThickness="1"/>
                </StackPanel>
            </Grid>
            
            <TextBlock Text="Results" FontWeight="Bold" Margin="0,20,0,10"/>
            <TextBox Height="150" Background="White" BorderBrush="#D0D0D0" BorderThickness="1" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>
    </Grid>
</Window>
